# Radar Imobiliário — variáveis de ambiente (copie para .env)
RADAR_LLM_PROVIDER=openai
RADAR_LLM_MODEL=gpt-4o-mini
RADAR_OPENAI_API_KEY=

# Postgres local via Docker (docker compose up -d db)
RADAR_DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/radar
RADAR_DB_SCHEMA=poc_ia
RADAR_ENVIRONMENT=local

# Opcional: quando o banco está em VPC privada e o hostname não resolve por DNS
# público, mas o IP privado é alcançável (VPN). Força o IP mantendo SSL.
# RADAR_DB_HOST_ADDR=10.0.0.10
